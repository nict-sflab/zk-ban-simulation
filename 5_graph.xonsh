import sys
sys.path.insert(0, "")

from pathlib import Path

import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.dates as mdates

from sor.params import ANALYSIS_OUTPUT_FILE


plt.rcParams["text.usetex"] = False

csv_path = Path(ANALYSIS_OUTPUT_FILE)

out_dir = Path("plots")
out_dir.mkdir(exist_ok=True)

df = pd.read_csv(csv_path, encoding="utf-8-sig")
df.columns = df.columns.str.strip()

x_col = "period′"
df[x_col] = pd.to_datetime(df[x_col])

numeric_cols = [
    "ΔL(zk-BAN)",
    "T(zk-BAN)",
    "ΔL_diff(related-work)",
    "T_diff(related-work)",
    # "Innovation1(ΔL_diff/ΔL)",
    # "Innovation2(ΔL/(T*K))",
    # "Total(ΔL_diff/(T*K))",
]


for col in numeric_cols:
    df[col] = pd.to_numeric(df[col], errors="coerce")

df = df.sort_values(x_col)


def plot_lines(series, title, ylabel, filename):
    plt.figure(figsize=(12, 6))

    for y_col, label in series:
        plt.plot(
            df[x_col],
            df[y_col],
            marker="o",
            markersize=2,
            linewidth=1.5,
            label=label,
        )

    plt.title(title, fontsize=30)
    plt.xlabel("period′", fontsize=20)
    plt.ylabel(ylabel, fontsize=20)

    plt.grid(True, alpha=0.3)
    plt.legend(fontsize=20)

    ax = plt.gca()
    ax.invert_xaxis()
    ax.xaxis.set_major_locator(mdates.MonthLocator(interval=2))
    ax.xaxis.set_major_formatter(mdates.DateFormatter("%Y-%m"))

    plt.xticks(rotation=45, fontsize=20)
    plt.yticks(fontsize=20)

    plt.tight_layout()

    save_path = out_dir / filename
    plt.savefig(save_path, dpi=300, bbox_inches="tight")
    plt.show()
    plt.close()

    print(f"saved: {save_path}")


# delta_L
plot_lines(
    series=[
        ("ΔL(zk-BAN)", r"$\delta_L$(zk-BAN)"),
        ("ΔL_diff(related-work)", r"$\delta_L$(classic)"),
    ],
    title=r"$\delta_L$ reduction in zk-BAN",
    ylabel=r"$\delta_L$",
    filename="01_delta_L_comparison.png",
)

# T
plot_lines(
    series=[
        ("T(zk-BAN)", r"$T$(zk-BAN)"),
        ("T_diff(related-work)", r"$T$(classic)"),
    ],
    title=r"$T$ reduction in zk-BAN",
    ylabel=r"$T$",
    filename="02_T_comparison.png",
)
